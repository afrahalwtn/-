# Keep false ONLY when accessed on 127.0.0.1 during development.
# Set true behind HTTPS for iPad, mobile, or multi-device use.
AFRAH_SECURE_COOKIES=true
# Only hostnames actually configured in your LAN or HTTPS reverse proxy:
AFRAH_ALLOWED_HOSTS=localhost,127.0.0.1,afrah.local
# Private directory containing database, image uploads and secret.key:
AFRAH_DATA_DIR=./data
