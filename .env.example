# Local mode: keep both Supabase values empty. Uses SQLite as before.
PORT=3000
NODE_ENV=development
AFRAH_SECURE_COOKIES=false

# Cloud mode: set BOTH values in the private environment of the Node server.
# Do not commit real keys or passwords, including in GitHub repositories.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required only on first cloud run to create the administrator.
AFRAH_ADMIN_PASSWORD=

# Legacy local SQLite first-run demo migration only.
AFRAH_STAFF_PASSWORD=

# Cloud production must use NODE_ENV=production,
# AFRAH_SECURE_COOKIES=true and HTTPS.
