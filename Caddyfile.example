# OPTIONAL LAN deployment example (Caddy required on the HOST PC)
# Set AFRAH_ALLOWED_HOSTS to include afrah.local
# Set AFRAH_SECURE_COOKIES=true
# Map afrah.local to the LAN address of the PC using local DNS.
# Install/trust Caddy's local CA root on EACH phone/iPad before logging in.
# Never open these credentials on unsecured HTTP over public Wi-Fi.

afrah.local {
    tls internal
    reverse_proxy 127.0.0.1:8000
}
